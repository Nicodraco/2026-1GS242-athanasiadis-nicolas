# ── Servidor ───────────────────────────────────────────────────────
# Puerto en que escucha la API (default: 4000)
API_PORT=4000

# ── Base de datos ──────────────────────────────────────────────────
# Ruta al archivo SQLite (se crea automáticamente)
BUN_DB_PATH=./data/urbansprout.sqlite

# ── Stripe ─────────────────────────────────────────────────────────
# Llave secreta desde https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreto del webhook (genera con: stripe listen --print-secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS ───────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── URLs ───────────────────────────────────────────────────────────
# URL pública del storefront (para success_url / cancel_url de Stripe)
APP_URL=http://localhost:3000
