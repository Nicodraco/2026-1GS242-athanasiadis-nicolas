    "hono": "^4.10.3",
    "mongodb": "^6.20.0",
    "stripe": "^18.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "typescript": "^5.9.3"
  }
}

